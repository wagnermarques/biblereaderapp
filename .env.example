# Copy this file to .env.local (gitignored) and fill in your Supabase project's
# values: Project Settings > API in the Supabase dashboard.
#
# The anon key is meant to be public — it's safe to ship in the built JS bundle.
# Access control is enforced by the Row Level Security policies in
# supabase/migrations/0001_init.sql, not by keeping this key secret.
#
# Without these set, the app runs exactly as before: fully offline, no login,
# bookmarks stay in localStorage only.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
